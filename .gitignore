# TimerMeet – .gitignore
# Keep personal meeting data and runtime artifacts out of source control.

# ─── Personal data (real meeting titles, notes, Teams links) ────────────────
/data/meetings.json
/data/settings.json
/data/*.lock
/data/*.corrupt-*
/data/.tmp-*

# ─── OS generated ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / editor ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Legacy PHP temp files ───────────────────────────────────────────────────
*.tmp
*.log

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
env/

# ─── PyInstaller build artifacts (TimerMeet.exe itself IS committed) ────────
/build/
/dist/
*.spec

# ─── Claude Code local session state (agents/skills below ARE committed) ───
.claude/settings.local.json
